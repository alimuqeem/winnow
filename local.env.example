# Copy to local.env (git-ignored) and fill in. Read by scripts/bootstrap.sh.
# Your Apple Developer Team ID (a free "Personal Team" works):
#   Xcode › Settings › Accounts, or: defaults read com.apple.dt.Xcode IDEProvisioningTeamByIdentifier
WINNOW_TEAM=ABCDE12345
# A reverse-DNS prefix you own; the app becomes <prefix>.Winnow
WINNOW_BUNDLE_PREFIX=com.yourname
